{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "sgi-protege-frotas"
      }
    }
  ],
  "services": {
    "sgi-protege-frotas": {
      "root": ".",
      "framework": "express",
      "buildCommand": "npm install && npx prisma generate && npx prisma migrate deploy"
    }
  }
}
